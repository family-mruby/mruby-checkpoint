 #define wakeup_tick_ (mrb->task.wakeup_tick)
 #define switching_   (mrb->task.switching)
 
+/* The scheduler asks the VM for a context switch. Every request also moves
+ * switch_requests, so that code which sets switching for a reason of its own
+ * (mruby-checkpoint's safe point request) can tell afterwards whether the
+ * scheduler asked too, even when the flag was set already. Only a change of
+ * the count means anything: a request made from the tick while the VM thread
+ * makes one may be counted once. */
+#define task_request_switch(mrb) do { \
+  (mrb)->task.switch_requests++; \
+  (mrb)->task.switching = TRUE; \
+} while (0)
+
+/* The scheduler's switch count: the requests made on the VM's thread and
+ * those of a tick on another thread (which moves switch_requests_async
+ * before it sets switching). It only ever moves on. */
+#define task_switch_requests(mrb) \
+  ((uint32_t)((mrb)->task.switch_requests + (mrb)->task.switch_requests_async))
+
 /* Recover the mrb_task that owns the current mruby context */
 #define MRB2TASK(mrb) ((mrb_task *)((uint8_t *)(mrb)->c - offsetof(mrb_task, c)))
 
