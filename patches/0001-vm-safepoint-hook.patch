+__attribute__((noinline))
+#endif
+static mrb_bool
+task_stop_requested(mrb_state *mrb)
+{
+  if (mrb->task.switching && !mrb->exc && !mrb->gc.iterating &&
+      !task_across_c_boundary(mrb)) {
+    if (mrb->safepoint_hook) {
+      mrb->safepoint_hook(mrb);
+      if (!mrb->task.switching) return mrb->c->status == MRB_TASK_STOPPED;
+    }
+    if (mrb->c != mrb->root_c) return TRUE;
+    /* The root context has no task to leave: the scheduler clears the flag
+       before it runs a task (execute_task) anyway. Cleared here, so that a
+       flag a HAL raises while the root context runs (one that ends
+       timeslices on a cadence, running task or not) does not send every
+       following instruction down this slow path. */
+    mrb->task.switching = FALSE;
+  }
+  return mrb->c->status == MRB_TASK_STOPPED;
